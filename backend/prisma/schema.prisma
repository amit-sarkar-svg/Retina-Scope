generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SCREENING_OPERATOR
  SPECIALIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ScreeningStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  REVIEW_PENDING
  REVIEWED
  FAILED
}

enum DRSeverity {
  NO_DR
  MILD
  MODERATE
  SEVERE
  PROLIFERATIVE
}

enum DMERisk {
  LOW
  MODERATE
  HIGH
}

enum ImageQualityStatus {
  ACCEPTED
  POOR
}

enum UncertaintyLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReferralPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LesionType {
  MICROANEURYSM
  HEMORRHAGE
  EXUDATE
  OTHER
}

enum ReviewDecision {
  AGREE
  MODIFY
  REQUEST_RESUBMISSION
  REJECT
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              UserRole           @default(SCREENING_OPERATOR)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  specialistReviews SpecialistReview[]

  @@map("users")
}

model Patient {
  id          String      @id @default(uuid())
  patientCode String      @unique
  name        String
  age         Int
  gender      Gender      @default(OTHER)
  phone       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  screenings  Screening[]

  @@index([patientCode])
  @@index([name])
  @@map("patients")
}

model Screening {
  id               String            @id @default(uuid())
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  imagePath        String
  status           ScreeningStatus   @default(UPLOADED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  aiResult         AIResult?
  lesions          Lesion[]
  specialistReview SpecialistReview?

  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@map("screenings")
}

model AIResult {
  id                     String             @id @default(uuid())
  screeningId            String             @unique
  screening              Screening          @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  drGrade                Int
  severity               DRSeverity
  drConfidence           Float
  dmeRisk                DMERisk
  dmeConfidence          Float
  imageQualityStatus     ImageQualityStatus
  imageQualityScore      Float
  uncertaintyLevel       UncertaintyLevel
  abstain                Boolean            @default(false)
  referralPriority       ReferralPriority
  referralRecommendation String
  segmentationMaskPath   String?
  gradcamPath            String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([screeningId])
  @@map("ai_results")
}

model Lesion {
  id          String     @id @default(uuid())
  screeningId String
  screening   Screening  @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  type        LesionType
  count       Int
  createdAt   DateTime   @default(now())

  @@index([screeningId])
  @@map("lesions")
}

model SpecialistReview {
  id          String         @id @default(uuid())
  screeningId String         @unique
  screening   Screening      @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  decision    ReviewDecision
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([screeningId])
  @@index([reviewerId])
  @@map("specialist_reviews")
}
