# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/retinascope?schema=public"

# JWT Authentication
JWT_SECRET="retinascope_super_secret_jwt_key_for_development_replace_in_production"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV="development"

# Uploads Configuration
UPLOAD_DIR="./uploads"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Future AI Service Integration URL (Mock / Real)
AI_SERVICE_URL="http://localhost:8000"
